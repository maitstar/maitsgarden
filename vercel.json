{
  "buildCommand": "npx quartz build",
  "outputDirectory": "public",
  "installCommand": "npm install && rm -rf .quartz/plugins && npx quartz plugin install --from-config",
  "framework": null,
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}
